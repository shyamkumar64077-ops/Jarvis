# Copy to .env and fill in real values. NEVER commit .env.

# --- GitHub Actions / Codespaces -------------------------------------------
# PAT with `codespace` scope. Stored as the repo secret CODESPA_PAT.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- cs-switch-worker (Cloudflare Worker secrets) ---------------------------
# Set with: wrangler secret put <NAME>
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# secret_token Telegram echoes back in X-Telegram-Bot-Api-Secret-Token.
# WEBHOOK_SECRET=replace_with_a_long_random_string

# --- Local LLM provider keys (keyproxy) ------------------------------------
# Comma-separated. Read by ~/keyproxy/server.mjs from ~/keyproxy/.env.
# GROQ_KEYS=gsk_xxx,gsk_yyy
# OPENROUTER_KEYS=sk-or-v1-xxx
# NVIDIA_KEYS=nvapi-xxx
# GEMINI_KEYS=AQ.Ab8xxx
