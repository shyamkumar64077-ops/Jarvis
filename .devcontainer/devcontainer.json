{
  "name": "Hermes Environment",
  "postStartCommand": "nohup bash -c 'sleep 10; bash .devcontainer/start-hermes.sh' > /tmp/start-hermes.log 2>&1 &",
  "forwardPorts": [3001, 8642],
  "portsAttributes": {
    "8642": { "label": "Hermes Gateway", "onAutoForward": "silent", "visibility": "public" },
    "3001": { "label": "FreeLLM API", "onAutoForward": "silent", "visibility": "public" }
  }
}
